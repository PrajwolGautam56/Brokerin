# ============================================
# BrokerIn Frontend Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env
#
# Note: In React, environment variables must be prefixed with REACT_APP_
# to be accessible in the browser. They are embedded at build time.

# ============================================
# REQUIRED - API Configuration
# ============================================

# Backend API Base URL
# For local development: http://localhost:3030
# For production: your-backend-url (e.g., https://api.brokerin.com)
REACT_APP_API_BASE_URL=http://localhost:3030

# ============================================
# OPTIONAL - Authentication
# ============================================

# Google OAuth Client ID (for Google Sign-In)
# Get this from: https://console.cloud.google.com/apis/credentials
# Note: There's a hardcoded fallback in GoogleSignInButton.js, but using env var is recommended
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================
# Development Notes
# ============================================
#
# After changing .env file:
# 1. Restart the development server (npm start)
# 2. Environment variables are embedded at build time
# 3. For production builds, set these in your hosting platform (Railway, Vercel, etc.)
#
# Important:
# - Variables must start with REACT_APP_ to be accessible
# - They are public in the browser (don't put secrets here)
# - Changes require server restart
